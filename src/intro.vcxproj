  <!-- Crinkler options, only when tools\link.exe (renamed crinkler.exe) is there.
       No /EXPORT of the NVIDIA Optimus / AMD PowerXpress flags (they cost 76 bytes): on a hybrid laptop
       the GPU is chosen in the Windows graphics settings or the driver panel.
       /TINYIMPORT: Crinkler's small import code (functions found by a hash of their name, -100 bytes).
       Crinkler warns that a future Windows version adding functions to an imported DLL may break it:
       for a safe build to ship with it, remove /TINYIMPORT (the exe is then about 100 bytes larger).
       /REUSE: src\crinkler.reuse is the best compression configuration found so far (models, section order,
       hash size). Crinkler writes its reuse file as a link output, which Clean and Rebuild delete, so it works
       on a copy in obj\Release: copied from src before the link, and back after the build (Crinkler rewrites
       it only when a fresh search beats it). -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32' And Exists('$(SolutionDir)tools\link.exe')">
    <PreLinkEvent>
      <Command>if exist "$(ProjectDir)crinkler.reuse" copy /y "$(ProjectDir)crinkler.reuse" "$(IntDir)crinkler.reuse" &gt;nul</Command>
      <Message>Crinkler reuse file: src\crinkler.reuse -&gt; obj</Message>
    </PreLinkEvent>
    <PostBuildEvent>
      <Command>if exist "$(IntDir)crinkler.reuse" copy /y "$(IntDir)crinkler.reuse" "$(ProjectDir)crinkler.reuse" &gt;nul</Command>
      <Message>Crinkler reuse file: obj -&gt; src\crinkler.reuse</Message>
    </PostBuildEvent>
    <Link>
      <AdditionalOptions>/CRINKLER /COMPMODE:SLOW /ORDERTRIES:8000 /HASHSIZE:500 /SATURATE /REUSE:"$(IntDir)crinkler.reuse" /UNSAFEIMPORT /TINYIMPORT /RANGE:opengl32 /REPORT:"$(SolutionDir)bin\crinkler_report.html" %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
